# STARPY__<Settings Module>__<Setting Key>=<Setting Value>
#
# The CLI only needs somewhere to cache the star catalog and constellation
# lines between runs (BCR-0005). The browser does all rendering and geocoding,
# so there is no server, no render cache and no User-Agent here.

STARPY__CATALOG__CACHE_DIR=/tmp/starpy-cache/catalog

STARPY__LOG__LEVEL=INFO
